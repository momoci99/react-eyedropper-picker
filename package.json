{
  "name": "react-eyedropper-picker-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -C packages/react-eyedropper-picker build",
    "test": "pnpm -C packages/react-eyedropper-picker test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -C apps/demo dev",
    "dev:host": "pnpm -C apps/demo dev:host",
    "build:demo": "pnpm build && pnpm -C apps/demo build",
    "e2e": "pnpm -C apps/demo e2e",
    "e2e:install": "pnpm -C apps/demo e2e:install",
    "format": "prettier --write \"{packages,apps}/*/{src,tests,e2e}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{packages,apps}/*/{src,tests,e2e}/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
