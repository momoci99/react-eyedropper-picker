{
  "name": "react-eyedropper-picker",
  "version": "0.1.0",
  "description": "React color picker with native EyeDropper API support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./loupe": {
      "import": {
        "types": "./dist/loupe.d.ts",
        "default": "./dist/loupe.js"
      },
      "require": {
        "types": "./dist/loupe.d.cts",
        "default": "./dist/loupe.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "react",
    "color-picker",
    "colorpicker",
    "eyedropper",
    "eye-dropper",
    "color",
    "picker",
    "hook"
  ],
  "author": "momoci99",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=19.2",
    "react-dom": ">=19.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
