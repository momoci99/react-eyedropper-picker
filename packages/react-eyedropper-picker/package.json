{
  "name": "react-eyedropper-picker",
  "version": "0.4.0",
  "description": "React color picker with native EyeDropper support and a pixel-accurate loupe for picking colors from images in every browser",
  "homepage": "https://momoci99.github.io/react-eyedropper-picker/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/momoci99/react-eyedropper-picker.git",
    "directory": "packages/react-eyedropper-picker"
  },
  "bugs": "https://github.com/momoci99/react-eyedropper-picker/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./loupe": {
      "import": {
        "types": "./dist/loupe.d.ts",
        "default": "./dist/loupe.js"
      },
      "require": {
        "types": "./dist/loupe.d.cts",
        "default": "./dist/loupe.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "loupe": [
        "./dist/loupe.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "react",
    "color-picker",
    "colorpicker",
    "eyedropper",
    "eye-dropper",
    "color",
    "picker",
    "hook",
    "loupe",
    "magnifier",
    "image-color-picker",
    "pick-color-from-image",
    "pixel"
  ],
  "author": "momoci99",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=19.2",
    "react-dom": ">=19.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "^1.3.0",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
