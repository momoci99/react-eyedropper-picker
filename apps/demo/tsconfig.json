{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // vite.config.ts imports ./plugins/*.ts with the extension (Vite's native config loader needs it).
    "allowImportingTsExtensions": true,
    "paths": {
      "react-eyedropper-picker": [
        "../../packages/react-eyedropper-picker/src/index.ts"
      ],
      "react-eyedropper-picker/loupe": [
        "../../packages/react-eyedropper-picker/src/loupe/index.ts"
      ]
    }
  },
  "include": ["src", "e2e", "plugins", "scripts", "vite.config.ts", "playwright.config.ts"]
}
