{
  "name": "demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "dev:host": "vite --open --host",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-eyedropper-picker": "workspace:*"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@shikijs/rehype": "^4.6.0",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "estree-util-value-to-estree": "^3.5.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.6"
  }
}
